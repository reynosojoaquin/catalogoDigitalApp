APP_VERSION=replace-with-release-version
APP_ENV=production
PUBLIC_DOMAIN=replace-with-public-domain
ACME_EMAIL=replace-with-certificate-email
PII_HASH_KEY=replace-with-a-long-random-secret
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=replace-with-public-domain
DJANGO_CORS_ALLOWED_ORIGINS=https://replace-with-public-domain
DJANGO_CSRF_TRUSTED_ORIGINS=https://replace-with-public-domain
DJANGO_SECURE_SSL_REDIRECT=true
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_SSLMODE=prefer
REDIS_URL=redis://redis:6379/0
AUTH_LOGIN_RATE=10/min
TRUSTED_PROXY_COUNT=1
TIME_ZONE=America/Santo_Domingo
DEFAULT_LANGUAGE=es-do
